NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# MySQL 8+. In development the backend creates the database and missing tables
# automatically, and falls back to another common local port (3306, 8889, 3307,
# 3308, 3310) when DB_PORT is not reachable. Production uses DB_PORT exactly.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=c2c_nearby_dev
DB_USER=root
DB_PASSWORD=root
DB_POOL_MAX=10
DB_SSL=false

LOG_LEVEL=info
CORS_ORIGINS=http://localhost:4200,http://localhost:4310
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Identity. production REQUIRES AUTH_DRIVER=firebase (the dev driver is rejected there).
# Outside production the default is "dev" (tokens look like "dev:<uid>").
# This applies to END USERS; the admin dashboard never uses Firebase.
AUTH_DRIVER=firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin dashboard: email + password only.
# The seeded row in admin_users is written on startup (or `npm run db:seed`).
# ADMIN_PASSWORD_HASH lets you pre-compute the scrypt hash instead of ADMIN_PASSWORD.
ADMIN_EMAIL=h3ndr45imbolon@gmail.com
ADMIN_PASSWORD=31SosMed!#
ADMIN_PASSWORD_HASH=
ADMIN_SIGN_IN_TEST=0

# HMAC key for admin session tokens (>= 32 characters in production).
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=12

# Face verification. Only a mock adapter exists; it never certifies a face.
FACE_DRIVER=mock
FACE_CALLBACK_SECRET=

# Local media storage (S3 arrives with the media phase).
UPLOAD_DIR=storage/uploads
PUBLIC_BASE_URL=http://127.0.0.1:4000
