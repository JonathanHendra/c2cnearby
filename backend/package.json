{
  "name": "c2c-nearby-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "C2C Nearby API — Fastify + Sequelize + MySQL modular monolith",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/database/cli.ts migrate",
    "db:migrate:status": "tsx src/database/cli.ts status",
    "db:migrate:undo": "tsx src/database/cli.ts undo",
    "db:migrate:undo:all": "tsx src/database/cli.ts undo:all",
    "db:seed": "node --import tsx/esm -e \"import './seed-admin.js'\"",
    "db:seed:undo": "tsx src/database/cli.ts seed:undo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "firebase-admin": "^14.5.0",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "umzug": "^3.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  }
}
